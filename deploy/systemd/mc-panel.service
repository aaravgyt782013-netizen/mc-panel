[Unit]
Description=MC Panel
After=network.target

[Service]
Type=simple
User=mc-panel
Group=mc-panel
WorkingDirectory=/opt/mc-panel
EnvironmentFile=/opt/mc-panel/.env
ExecStart=/usr/bin/node /opt/mc-panel/server/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
