[Unit]
Description=MC Panel
After=network.target

[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/mc-panel
EnvironmentFile=/opt/mc-panel/.env
ExecStart=/usr/bin/node /opt/mc-panel/server/dist/index.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/mc-panel /srv/minecraft

[Install]
WantedBy=multi-user.target
