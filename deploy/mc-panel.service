[Unit]
Description=MC Panel and Minecraft server manager
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=minecraft
Group=minecraft
WorkingDirectory=/opt/mc-panel
EnvironmentFile=-/opt/mc-panel/.env
ExecStart=/usr/bin/node /opt/mc-panel/server/dist/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
ReadWritePaths=/opt/mc-panel/server/data /srv/minecraft /srv/minecraft-backups
[Install]
WantedBy=multi-user.target
